{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "speelpenning/laravel-postcode-nl",
  "description": "A Laravel client using the Postcode.eu REST API for Dutch address verification.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Gerben Speelpenning",
      "email": "gerben@speelpenning.nl"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/config": "11.*|12.*",
    "illuminate/contracts": "11.*|12.*",
    "illuminate/routing": "11.*|12.*",
    "illuminate/support": "11.*|12.*",
    "illuminate/validation": "11.*|12.*"
  },
  "require-dev": {
    "laravel/laravel": "11.*|12.*",
    "phpunit/phpunit": "^11.0.1",
    "roave/security-advisories": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "Speelpenning\\PostcodeNl\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Speelpenning\\PostcodeNl\\PostcodeNlServiceProvider"
      ]
    }
  }
}
